DATABASE_URL=sqlite:///./credvault.db
JWT_SECRET_KEY=CHANGE_THIS_IN_LOCAL_ENVIRONMENT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AES_MASTER_KEY=GENERATE_A_32_BYTE_BASE64_KEY
STORAGE_PATH=./storage/encrypted
PRIVATE_KEY_PATH=./keys/issuer_private.pem
PUBLIC_KEY_PATH=./keys/issuer_public.pem
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173
